# WARDEN Configuration Template
# Copy this file to .env and customize values for local development.
# Never commit real API keys, credentials, or secrets to Git.

# Application Environment
WARDEN_ENV=development
WARDEN_LOG_LEVEL=INFO

# Workspace Configuration
# Root path of the isolated, disposable workspace for agent operations.
WARDEN_WORKSPACE_ROOT=./temp_workspace

# Security Policy Configuration
WARDEN_ENFORCE_WORKSPACE_CONTAINMENT=true
WARDEN_REQUIRE_APPROVAL_FOR_DESTRUCTIVE=true

# Fetch.ai / Agentverse Integration (Planned Phase 1)
# AGENTVERSE_API_KEY=your_agentverse_api_key_here
# AGENTVERSE_AGENT_NAME=warden-verification-agent
# AGENTVERSE_MAILBOX_KEY=your_mailbox_key_here

# ASI:One API Configuration (Planned Phase 1)
# ASI_ONE_API_KEY=your_asione_api_key_here
# ASI_ONE_BASE_URL=https://api.asi1.ai/v1
# ASI_ONE_MODEL=asi1-mini
