# WARDEN configuration template — placeholders only.
#
# scripts/setup.ps1 copies this file to .env (only when .env does not exist) and fills in
# AGENT_SEED for you. Never commit .env, real seeds, private keys or API credentials.
# Real environment variables override values in this file. Relative paths are resolved
# against the repository root, not the current directory.

# ---------------------------------------------------------------------------
# Core (local-only operation needs nothing beyond this section)
# ---------------------------------------------------------------------------
WARDEN_ENV=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
WARDEN_LOG_LEVEL=INFO

# Dedicated, disposable directory the agent may touch. Never point this at the
# repository root, your home directory or a drive root (WARDEN refuses to wipe those).
WARDEN_WORKSPACE_ROOT=./temp_workspace

# Persistent JSONL audit trail (file contents are never written to it).
# Leave the value empty to disable persistence.
WARDEN_AUDIT_LOG=./logs/audit.jsonl

# Safety controls. They are always enforced; "false" is rejected at startup.
WARDEN_ENFORCE_WORKSPACE_CONTAINMENT=true
WARDEN_REQUIRE_APPROVAL_FOR_DESTRUCTIVE=true

# Pending approvals expire after this many seconds (10-86400) and at most this many may wait at once.
# WARDEN_APPROVAL_TTL_SECONDS=300
# WARDEN_MAX_PENDING_APPROVALS=50

# ---------------------------------------------------------------------------
# Agent identity (REQUIRED to start the agent)
# ---------------------------------------------------------------------------
# Secret seed that determines the agent address. Same seed = same address on every restart.
# Left empty here on purpose: scripts/setup.ps1 (or `python -m warden.identity init`) generates
# a random 256-bit seed and never replaces an existing one. Losing or changing it changes
# the agent address. Treat it like a private key.
AGENT_SEED=
AGENTVERSE_AGENT_NAME=warden-verification-agent

# ---------------------------------------------------------------------------
# Optional: authorization token signing
# ---------------------------------------------------------------------------
# Not needed. Tokens and pending approvals live in memory for at most 5 minutes, so a fresh
# random key per process is safest. If you set one it must be 32+ random characters.
# WARDEN_SECRET_KEY=

# ---------------------------------------------------------------------------
# Optional: local runtime
# ---------------------------------------------------------------------------
# The agent binds 127.0.0.1 only (use `run_agent --bind-all` to override; this exposes it).
# WARDEN_AGENT_PORT=8000

# Chat senders (agent addresses) allowed to approve actions requested by OTHER senders,
# comma separated. Empty = only the requester can approve its own actions.
# WARDEN_APPROVER_ADDRESSES=

# ---------------------------------------------------------------------------
# Optional: Agentverse mailbox & discovery (see docs/INTEGRATION.md)
# ---------------------------------------------------------------------------
# Opt in to mailbox mode. Setting this does NOT connect anything by itself: the mailbox must
# still be provisioned for your Agentverse account through the local agent inspector.
# WARDEN_USE_MAILBOX=false
# Deprecated: uAgents 0.26.1 does not consume a mailbox key. It only selects mailbox mode.
# AGENTVERSE_MAILBOX_KEY=
# Publish the Agent Chat Protocol manifest to Almanac on startup (for discovery):
# AGENTVERSE_PUBLISH_MANIFEST=false
# Agent description and README path for Agentverse profile:
# AGENTVERSE_DESCRIPTION=
# AGENTVERSE_README_PATH=

# ---------------------------------------------------------------------------
# Optional: ASI:One intent parsing (otherwise a deterministic rule-based parser is used)
# ---------------------------------------------------------------------------
# ASI_ONE_API_KEY=your_asi_one_api_key_here
# ASI_ONE_BASE_URL=https://api.asi1.ai/v1
# ASI_ONE_MODEL=asi1-mini


# ---------------------------------------------------------------------------
# Optional: Auditor uAgent (independent multi-agent verification)
# ---------------------------------------------------------------------------
# WARDEN_AUDITOR_UAGENT_ENABLED=false
# WARDEN_AUDITOR_PORT=8001
# WARDEN_AUDITOR_TIMEOUT_SECONDS=5.0
# WARDEN_AUDITOR_SEED=
